<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- Release APK blocks cleartext HTTP by default; browser does not. This allows http:// to your LAN API. -->
    <!-- For production, use HTTPS and remove or narrow this (domain-config only). -->
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
